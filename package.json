{
  "name": "numo-desktop",
  "version": "0.1.0",
  "description": "A personal invoice creator.",
  "private": true,
  "main": "out/main/index.js",
  "dependencies": {
    "electron-store": "^11.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.preview.config.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
